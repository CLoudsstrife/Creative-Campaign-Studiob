
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Campaign {
  id             String   @id @default(cuid())
  userId         String   @db.Uuid
  title          String
  description    String?
  brandName      String?
  targetAudience String?
  platform       String?
  tone           String?
  status         String   @default("draft")
  aiResult       String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("campaigns")
}

model AIGenerationUsage {
  userId             String   @id @db.Uuid
  generationCount    Int      @default(0)
  promptTokenCount   BigInt   @default(0)
  responseTokenCount BigInt   @default(0)
  updatedAt          DateTime @updatedAt

  @@map("ai_generation_usage")
}

model CampaignPreset {
  slug                String   @id
  brandName           String
  productDescription  String   @db.Text
  targetAudience      String   @db.Text
  platform            String   @default("Instagram")
  tone                String   @default("Friendly")
  brandContext        String   @db.Text
  contentPillars      String   @db.Text
  editorialRules      String   @db.Text
  defaultGoogleSearch Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@map("campaign_presets")
}

